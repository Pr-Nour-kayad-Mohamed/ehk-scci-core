    given-names: "Mohamed"
    affiliation: >-
      Ministère de l’Éducation nationale et de la Formation
      professionnelle (MENFOP), République de Djibouti
    orcid: "https://orcid.org/0009-0002-1443-7599"

repository-code: "https://github.com/Pr-Nour-kayad-Mohamed/ehk-scci-core"
